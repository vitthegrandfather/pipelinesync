# Copy to .env before `docker compose up --build`.
# None of these values are live CRM credentials.

APP_NAME=pipelinesync
ENVIRONMENT=development
TESTING=false

DATABASE_URL=postgresql+asyncpg://pipelinesync:pipelinesync@postgres:5432/pipelinesync
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me-in-production-use-a-long-random-string

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173

DEMO_API_KEY=demo-api-key
DEMO_ADMIN_EMAIL=admin@pipelinesync.demo
DEMO_ADMIN_PASSWORD=demo12345
DEMO_ADMIN_NAME=Demo Admin

ACCESS_TOKEN_EXPIRE_MINUTES=480
ALGORITHM=HS256

INTAKE_RATE_LIMIT=60
INTAKE_RATE_WINDOW_SECONDS=60

SEED_ON_STARTUP=true
LOG_LEVEL=INFO
LOG_JSON=true
